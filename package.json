{
  "name": "awesome-ai-web-design",
  "version": "1.0.0",
  "private": true,
  "description": "84 free design systems with original AI prompts and local previews",
  "scripts": {
    "dev": "node scripts/build_site.mjs --output public && node scripts/run-framework.mjs dev",
    "build": "node scripts/build_site.mjs --output public && node scripts/run-framework.mjs build",
    "build:bundle": "python3 scripts/build.py",
    "test": "python3 -m unittest discover -s tests -v",
    "test:preview": "node --test tests/test_preview_routing.mjs",
    "test:catalog": "node --test tests/test_catalog_workflows.mjs",
    "prompts": "python3 scripts/rewrite_prompts.py",
    "dev:source": "python3 scripts/serve.py",
    "build:static": "node scripts/build_site.mjs",
    "test:media": "node --test tests/test_media_proxy.mjs",
    "test:pinterest": "node --test tests/test_pinterest_interactions.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "26.1.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  }
}
