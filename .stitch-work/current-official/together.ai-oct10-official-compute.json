w\" alt=\"\" class=\"img-cover\" data-categories=\"essential\" data-has-derived-categories=\"1\"><div class=\"code-box\"><div class=\"code-box_inner\"><div class=\"code-box_ui\"><div class=\"code-box_dots w-embed\"><svg width=\"100%\" viewBox=\"0 0 36 8\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n  <circle cx=\"4\" cy=\"4\" r=\"4\" fill=\"#1D2E40\"></circle>\n  <circle cx=\"18\" cy=\"4\" r=\"4\" fill=\"#1D2E40\"></circle>\n  <circle cx=\"32\" cy=\"4\" r=\"4\" fill=\"#1D2E40\"></circle>\n</svg></div></div><div class=\"code-box_content\"><div class=\"code-box_code-wrap\"><div no-scrollbar=\"true\" class=\"code-box_code-inner swiper-no-swiping\"><div data-tabs=\"code\" no-scrollbar=\"\" class=\"code-box_code w-embed\"><pre class=\" line-numbers codeblock language-python\" tabindex=\"0\"><code class=\" language-python\">import { CodeSandbox } from \"@codesandbox/sdk\"\n\nconst sdk = new CodeSandbox()\n\nconst sandbox = await sdk.sandboxes.create({ id: \"node-template\" })\n\nconst client = await sandbox.connect()\n\nawait client.commands.run(\"npm install &amp;&amp; npm run build\")\n\nconst previewUrl = client.hosts.getUrl(3000)\n\nawait sdk.sandboxes.hibernate(sandbox.id)\n\n// Snapshot saved — resume anytime in &lt;1s<span class=\"line-numbers-rows\"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span></code></pre></div></div></div></div></div></div></div></div></div></div></div></li><li role=\"button\" data-status=\"not-active\" data-tabs=\"inner-item\" tabindex=\"0\" class=\"stack-tabs_item\"><div class=\"stack-tabs_item-head\"><div class=\"cc-meta-12\"><div data-transition=\"\" data-wf--icon-tile--theme=\"blue\" class=\"menu-icon\"><img src=\"https://cdn.prod.website-files.com/69654e88dce9154b5f1206dd/69dd28211c608d7834bbbee3_icon-dark_folder.svg\" loading=\"lazy\" alt=\"\" class=\"icon-24\" data-categorie